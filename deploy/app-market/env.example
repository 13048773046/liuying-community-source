# 复制为 /www/wwwroot/Yosar-community/services/app-market.env，chmod 600
# 必须把下面两个值替换为强随机值；主服务与 app-delivery 必须一致。
APP_TICKET_SECRET=CHANGE_ME_TICKET_SECRET
APP_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN
APP_TICKET_TTL=1800
APP_MANIFEST_URL=http://127.0.0.1:8790/community/api/internal/app-download/manifest
APP_RESOLVER_URL=http://127.0.0.1:8793/resolve
APP_ALLOW_PRIVATE=0
# 可选：合法授权的登录型网盘解析服务
# APP_NFD_BASE_URL=
# APP_NFD_PARSE_PATH=/api/parse
# APP_NFD_TOKEN=

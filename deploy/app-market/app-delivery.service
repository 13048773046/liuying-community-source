[Unit]
Description=Liuying App Market Download Gateway
After=network.target community.service app-resolver.service

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/Yosar-community/services/app_delivery
EnvironmentFile=/www/wwwroot/Yosar-community/services/app-market.env
Environment=APP_DELIVERY_HOST=127.0.0.1
Environment=APP_DELIVERY_PORT=8792
ExecStart=/usr/bin/python3 /www/wwwroot/Yosar-community/services/app_delivery/app.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
